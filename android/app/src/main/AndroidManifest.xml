<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- NEW this batch — see core/utils/contact_picker.dart. Even the "external pick" flow needs
         this actually GRANTED on some devices/plugin versions to read back the picked contact's
         name/phone; without it, selecting a contact was reproducing a hard native crash instead
         of a catchable error. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
     <!-- ===== النسخ الاحتياطي المحلي — بداية الإضافة =====
         مطلوب فقط لكتابة ملف .dyoonibackup مباشرة داخل Download/ديوني بدل نافذة اختيار مسار:
         - maxSdkVersion="28": النظام يتجاهل هذا الإذن تلقائيًا على أندرويد 10+ (لا حاجة لطلبه هناك).
         - requestLegacyExternalStorage أدناه على <application>: يُعيد سلوك التخزين القديم
           (كتابة مباشرة لأي مسار عام) لكن فقط على أندرويد 10 (API 29) بالتحديد — أندرويد 11+
           يتجاهل هذا الإعلان كليًا بحكم سياسة Scoped Storage من جوجل، وعندها يعتمد التطبيق على
           fallback الكتابة داخل مساحته الخاصة (راجع local_backup_provider.dart).
         تصحيح: كان هذا السطر سقط بالخطأ من التعديل السابق على هذا الملف — أعدته هنا. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- ===== النسخ الاحتياطي المحلي — نهاية الإضافة ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="dyooni"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true">
        <!-- Camera-crash mitigation notes: `largeHeap` above raises this app's own memory
             ceiling, which reduces (but never fully guarantees against) Android killing this
             app's background process to free memory while the native camera app is in the
             foreground — see core/... image_source_dialog.dart's picker call, which now also
             caps the CAPTURED photo's resolution (maxWidth/maxHeight), addressing the actual
             memory spike more directly than largeHeap alone did. A complete, unconditional fix
             would still require wiring up Flutter's state-restoration APIs (RestorationMixin /
             restorationScopeId) so an in-progress form can survive a process restart even on a
             severely memory-constrained device — a larger, separate change to scope explicitly
             if the two mitigations together aren't enough. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ===== Facebook Login SDK — بداية الإضافة ===== -->
        <!-- القيم الفعلية موجودة في android/app/src/main/res/values/strings.xml، وليس هنا،
             حتى لا يُضطر أحد لتعديل هذا الملف عند تغيير المفاتيح لاحقًا. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <!-- تُستخدم داخليًا بواسطة حزمة flutter_facebook_auth لعرض تدفق تسجيل الدخول -->
        <activity
            android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:exported="false" />

        <!-- تستقبل رجوع المستخدم من متصفح/تطبيق فيسبوك بعد إتمام تسجيل الدخول -->
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>
        <!-- ===== Facebook Login SDK — نهاية الإضافة ===== -->
    </application>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- يسمح لتطبيق ديوني بالتحقق من وجود تطبيق فيسبوك/Messenger المثبت على الجهاز
             (Android 11+ يتطلب هذا التصريح صراحة بسبب Package Visibility) -->
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
        <!-- NEW this batch — same Package Visibility requirement (Android 11+), but for the
             contact-picker intent used by core/utils/contact_picker.dart. Without this, launching
             the system contact picker can silently fail or crash instead of just returning null. -->
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
        </intent>
    </queries>
</manifest>
